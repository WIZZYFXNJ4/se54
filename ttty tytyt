async def handle_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user_data = context.user_data
    
    if not user_data.get('activated'):
        await query.message.reply_text("❌ Please log in 🔒 to use this tool.")
        return
    
    if user_data.get('tutorial') and query.data != "refresh_balance":
        await query.message.reply_text("📚 Complete the guided tutorial before using these features!")
        return
    
    if query.data == "refresh_balance":
        await query.message.reply_text("🔄 Checking balance updates...")
        await asyncio.sleep(2)
        await query.message.reply_text("ℹ️ No update has been made to your balance")
    
    elif query.data == "launch_token":
        await launch_token(update)
    elif query.data == "start_pump":
        await pumping(update)
    elif query.data == "fake_metrics":
        await fake_metrics(update)
    elif query.data == "dump":
        await dump(update)
    else:
        await query.message.reply_text("⚙️ Feature in development")

